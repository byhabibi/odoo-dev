<odoo>

    <record id="view_plc_tree" model="ir.ui.view">
        <field name="name">plc.data.tree</field>
        <field name="model">plc.data</field>
        <field name="arch" type="xml">
            <tree>
                <field name="machine_name"/>
                <field name="counter"/>
                <field name="timestamp"/>
            </tree>
        </field>
    </record>

    <record id="view_plc_form" model="ir.ui.view">
        <field name="name">plc.data.form</field>
        <field name="model">plc.data</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="machine_name"/>
                        <field name="counter"/>
                        <field name="timestamp"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>